# ============================================================
# Agri-Energy Desk — Laravel PRODUCTION environment
# Copy to /var/www/agrienergy-prod/shared/.env   (owner agrienergy, chmod 600)
#
#   APP_KEY:  echo "base64:$(openssl rand -base64 32)"   → paste the value
#
# release-prod.sh refuses to deploy while any CHANGE_ME remains, APP_KEY is
# unset, APP_DEBUG is not false, or DB_CONNECTION is not pgsql.
#
# Keep values plain (KEY=value, no trailing comments): release-prod.sh reads
# the DB_* lines directly to take its pre-migrate pg_dump.
# ============================================================

APP_NAME="Agri-Energy Desk"
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://agrienergy.nrep.ug

# Used for password-reset / email-verification links and CORS.
FRONTEND_URL=https://agrienergy.nrep.ug

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ── Session / Sanctum ────────────────────────────────────────────────
# Single origin. SESSION_DOMAIN stays BLANK (host-only cookie) — see the
# note in api.env.uat.example for why a fixed domain breaks.
SANCTUM_STATEFUL_DOMAINS=agrienergy.nrep.ug
SESSION_DOMAIN=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Logging ──────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL only. The VM's MariaDB will NOT work: the schema uses jsonb and
# search uses ilike + tsvector.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrienergy_desk
DB_USERNAME=agrienergy
DB_PASSWORD=CHANGE_ME

# ── Cache / queue ────────────────────────────────────────────────────
# No jobs are queued and nothing is scheduled, so no worker or cron is needed.
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

BCRYPT_ROUNDS=12

# ── First admin ──────────────────────────────────────────────────────
# Deliberately NOT here. RolesAndAdminSeeder reads ADMIN_EMAIL/ADMIN_PASSWORD
# with env(), and once config is cached (every release caches it) env()
# ignores this file — the seeder would silently fall back to the prototype
# credentials, which are public. Pass them inline instead, once:
#   ADMIN_EMAIL=… ADMIN_PASSWORD=… php artisan db:seed --class=RolesAndAdminSeeder --force

# ── Mail ─────────────────────────────────────────────────────────────
# Registration and verification emails need real SMTP in production.
# `log` writes them to storage/logs instead of sending — if SMTP is not
# issued yet, set MAIL_MAILER=log and blank the CHANGE_ME values below, or
# the release refuses to run.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=agrienergy@nrep.go.ug
MAIL_FROM_NAME="${APP_NAME}"
