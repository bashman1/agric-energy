# ============================================================
# Agri-Energy Desk — frontend BUILD environment
# Copy to  /var/www/agrienergy/repo/deploy/env/ui.env.production
# deploy.sh installs it as UI/.env.production before the build.
#
# Everything here is BUILD-TIME ONLY. The frontend is a static export;
# there is no Node process at runtime to read an environment.
#
# There is no SESSION_SECRET any more — auth is a Sanctum bearer token
# held in the browser, not a server-side session cookie. There are no
# NEXT_PUBLIC_* variables either: Laravel serves the bundle, so the API
# is same-origin and the code uses the relative "/api/v1".
# ============================================================

# ── Laravel API, at build time ───────────────────────────────────────
# Where the export prerenders the public pages FROM. Points at the
# loopback nginx listener so the build never leaves the droplet and
# skips a TLS round-trip.
#
# This must be reachable when deploy.sh runs, or the export ships empty
# pages. build-ui.sh refuses to start if it cannot reach this URL.
API_URL=http://127.0.0.1:8080/api/v1
