# ============================================================
# Agri-Energy Desk — Laravel UAT environment
# Copy to /var/www/agrienergy/repo/api/.env   (chmod 600)
#
# Then:  php artisan key:generate
#        php artisan storage:link
#        php artisan migrate --force
# ============================================================

APP_NAME="Agri-Energy Desk"
APP_ENV=production
APP_KEY=                        # php artisan key:generate
APP_DEBUG=false                 # never true on a public host
APP_TIMEZONE=UTC
APP_URL=https://menu.smartcollect.co.ug

# Used for password-reset / email-verification links and CORS.
FRONTEND_URL=https://menu.smartcollect.co.ug

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ── Session / Sanctum ────────────────────────────────────────────────
# Single origin, so the stateful domain is just the one host.
SANCTUM_STATEFUL_DOMAINS=menu.smartcollect.co.ug
#
# SESSION_DOMAIN is deliberately BLANK. Left blank, Laravel omits the Domain
# attribute and the cookie is host-only, which always matches whatever host
# the app is actually served from. Setting it to a specific domain (it used
# to read `.menu.smartcollect.co.ug`) means the browser rejects the cookie —
# "Cookie XSRF-TOKEN has been rejected for invalid domain" — the moment the
# value and the host drift apart, which happens on every new environment.
#
# Nothing in this app reads the session anyway: auth is a Sanctum BEARER
# token held in sessionStorage (UI/lib/auth/token.ts), and there is no CSRF
# flow and no cookie login. The cookies are set only because the framework
# starts a session by default.
SESSION_DOMAIN=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Logging ──────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrienergy_desk
DB_USERNAME=agrienergy
DB_PASSWORD=CHANGE_ME_strong_password

# ── Cache / queue ────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

BCRYPT_ROUNDS=12

# ── Mail ─────────────────────────────────────────────────────────────
# `log` writes mail to storage/logs instead of sending — a reasonable
# UAT default until real SMTP credentials are issued.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=agrienergy@nrep.go.ug
MAIL_FROM_NAME="${APP_NAME}"
