# ============================================================
# Agri-Energy Desk — PRODUCTION vhost (reference), STATIC EXPORT variant
#   https://agrienergy.nrep.ug
#
# A starting point for the vhost you write; derived from
# menu.smartcollect.co.ug.static.conf (UAT), which is NOT changed. The
# differences from UAT:
#   - root is /var/www/agrienergy-prod/current/public (release symlink)
#   - PHP goes to the dedicated pool socket /run/php/agrienergy.sock
#   - SCRIPT_FILENAME uses $realpath_root, required with symlinked releases
#   - separate log files
#
# Keep, exactly as UAT has them: the `^~ /api/v1` block, `= /up`,
# `^~ /storage/`, `^~ /_next/`, the `_entry` 404 block, and the
# try_files /static… /index.php fallback. The comments below explain each.
#
# This VM serves other sites: add this file only; do not edit theirs.
# It is self-contained (no `include`), because this VM's nginx is not
# Ubuntu's package and lacks snippets/fastcgi-php.conf.
#
# Install:
#   cp agrienergy.nrep.ug.conf.example /etc/nginx/sites-available/agrienergy.nrep.ug
#   ln -s ../sites-available/agrienergy.nrep.ug /etc/nginx/sites-enabled/
#
# The certificate does not exist yet, so for the FIRST run comment out the
# whole `listen 443` server block, reload, and let certbot add TLS:
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d agrienergy.nrep.ug
# Or keep the file as is and issue the certificate first with
#   certbot certonly --webroot -w /var/www/html -d agrienergy.nrep.ug
# while only the port-80 block is enabled. Renewal is automatic (the snap
# installs a timer); check with: certbot renew --dry-run
# ============================================================

server {
    listen 80;
    listen [::]:80;
    server_name agrienergy.nrep.ug;

    # certbot writes its challenge here before the redirect applies
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name agrienergy.nrep.ug;

    # --- TLS (certbot fills these in / manages renewal) ---------------
    ssl_certificate     /etc/letsencrypt/live/agrienergy.nrep.ug/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agrienergy.nrep.ug/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Laravel's docroot, through the `current` release symlink. The exported
    # frontend lives under ./static.
    root /var/www/agrienergy-prod/current/public;
    index index.php;

    charset utf-8;
    server_tokens off;

    # Media uploads and XLSX/PDF exports can be chunky.
    client_max_body_size 32m;

    access_log /var/log/nginx/agrienergy-prod.access.log;
    error_log  /var/log/nginx/agrienergy-prod.error.log;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript
               application/geo+json text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # ── Laravel: REST API ────────────────────────────────────────────
    # Must stay `^~ /api/v1` so it is matched before the static fallback,
    # or API calls would be answered with the HTML shell. This is the only
    # thing standing between the browser and its data — if it is wrong,
    # every page renders empty.
    location ^~ /api/v1 {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ── Laravel: health check (bootstrap/app.php `health: '/up'`) ────
    location = /up {
        try_files $uri /index.php?$query_string;
    }

    # ── Laravel: uploaded media (php artisan storage:link) ───────────
    # Only files that are meant to be public land here. View-only resource
    # documents deliberately do NOT — they live on the private disk and are
    # streamed through /api/v1 behind a signed URL, which is what makes the
    # restriction real. Do not add a location that exposes storage/app.
    location ^~ /storage/ {
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public";
    }

    # ── Frontend: hashed, immutable build assets ─────────────────────
    # The export writes these to static/_next/, but references them as
    # /_next/, so the prefix has to be mapped. Content-hashed filenames, so
    # they are safe to pin for a year: a rebuild changes the name.
    location ^~ /_next/ {
        alias /var/www/agrienergy-prod/current/public/static/_next/;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ── The collection shells are build artefacts, not pages ─────────
    # They exist on disk, so try_files would happily serve one as a page
    # that waits forever for a record called "_entry". Refused here as well
    # as in StaticSiteController, because nginx answers first.
    location ~ ^/(projects|technologies|themes|partners|resources|events|opportunities|news)/_entry(/|$) {
        return 404;
    }

    location ~ ^/index\.php$ {
        # The FastCGI parameters are spelled out here rather than included.
        # This VM's nginx is not Ubuntu's package, so it has no
        # snippets/fastcgi-php.conf, and nothing outside this file is assumed.
        # This is the standard fastcgi_params set.
        fastcgi_param QUERY_STRING       $query_string;
        fastcgi_param REQUEST_METHOD     $request_method;
        fastcgi_param CONTENT_TYPE       $content_type;
        fastcgi_param CONTENT_LENGTH     $content_length;
        fastcgi_param SCRIPT_NAME        $fastcgi_script_name;
        fastcgi_param REQUEST_URI        $request_uri;
        fastcgi_param DOCUMENT_URI       $document_uri;
        fastcgi_param SERVER_PROTOCOL    $server_protocol;
        fastcgi_param REQUEST_SCHEME     $scheme;
        fastcgi_param HTTPS              $https if_not_empty;
        fastcgi_param GATEWAY_INTERFACE  CGI/1.1;
        fastcgi_param SERVER_SOFTWARE    nginx;
        fastcgi_param REMOTE_ADDR        $remote_addr;
        fastcgi_param REMOTE_PORT        $remote_port;
        fastcgi_param SERVER_ADDR        $server_addr;
        fastcgi_param SERVER_PORT        $server_port;
        fastcgi_param SERVER_NAME        $server_name;
        fastcgi_param REDIRECT_STATUS    200;
        # httpoxy: never pass a client "Proxy:" header into the environment.
        fastcgi_param HTTP_PROXY         "";
        fastcgi_pass unix:/run/php/agrienergy.sock;   # own pool, not the shared one
        # $realpath_root, not $document_root: resolves `current` per request, so
        # PHP (and OPcache) see the real release path and never mix two releases.
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 120s;
    }

    # Nothing else may reach PHP.
    location ~ \.php$ {
        return 404;
    }

    # ── Frontend: the exported site ──────────────────────────────────
    # Exported directory-style (trailingSlash: true), so /projects/ is
    # static/projects/index.html.
    #
    # The final fallback to index.php is what serves record URLs: those have
    # no file, so Laravel's StaticSiteController decides between the
    # collection shell (200) and a real 404.
    location / {
        try_files /static$uri /static$uri/index.html /static$uri.html /index.php?$query_string;

        # HTML must revalidate or a deploy leaves stale pages — and stale
        # bundle references — pinned in browser caches. The hashed assets
        # above are the things that get cached hard, not the documents.
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
