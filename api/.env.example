# ============================================================
# Agri-Energy Desk — Laravel API environment
# Copy to .env and run: php artisan key:generate
# ============================================================

APP_NAME="Agri-Energy Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Next.js frontend origin(s) — CORS + Sanctum stateful domains + mail links.
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Initial administrator (created by RolesAndAdminSeeder).
ADMIN_EMAIL=admin@agrienergy.go.ug
ADMIN_PASSWORD=agrienergy2026

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrienergy_desk
DB_USERNAME=agrienergy
DB_PASSWORD=agrienergy

# Import the prototype's JSON content on seed (relative to the api/ dir).
LEGACY_DATA_DIR=../UI/data

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Mail — used for email verification + submission notifications.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="agrienergy@nrep.go.ug"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (production media uploads) — optional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
